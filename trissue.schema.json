{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "trissue configuration",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "color": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" }
  },
  "properties": {
    "$schema": { "type": "string" },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "Shown as \"<name> Triage\". Defaults to the repo name." },
        "color": { "$ref": "#/definitions/color", "description": "Color of the product name." }
      }
    },
    "background": { "$ref": "#/definitions/color", "description": "Background of the interface. Defaults to black." },
    "prompt": { "type": "string", "minLength": 1, "description": "Text above the issue input." },
    "instructions": { "type": "string", "minLength": 1, "description": "How issues should be written. Replaces the default guide." },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Only these models. Patterns match agent/model or the model id; * is a wildcard." },
        "block": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Never these models." }
      }
    },
    "checkmark": { "enum": ["green", "monochrome"], "description": "The checkmark next to \"Use default model\"." },
    "github": {
      "oneOf": [{ "type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$" }, { "const": false }],
      "description": "owner/repo to file issues on, or false to hide GitHub filing."
    },
    "labels": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Labels for GitHub issues. Ones the repo doesn't have are skipped." },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^(https?:|mailto:)", "description": "{title}, {body} and {issue} become the URL-encoded issue." },
          "description": { "type": "string", "minLength": 1, "description": "Where the link goes. Shown before it opens." }
        }
      }
    }
  }
}
